                        <Menu fx:id="menuRefactor" text="Refactor">
                            <MenuItem fx:id="menuItemRename" text="Rename" onAction="#onRenameFromProjectExplorer" />
                        </Menu>
                        <SeparatorMenuItem />
                        <MenuItem fx:id="menuItemGoToLine" text="Ir a la linea..." onAction="#onGoToLine" />
                        <MenuItem fx:id="menuItemGoToDefinition" text="Ir a definición" onAction="#onGoToDefinition" />
                        <MenuItem fx:id="menuItemSplitEditor" text="Dividir vista de editor" onAction="#onSplitEditor" />
                        <SeparatorMenuItem />
                        <MenuItem fx:id="menuItemFind" text="Buscar en archivo" onAction="#onFindInFile" />
                        <MenuItem fx:id="menuItemFindProject" text="Buscar en proyecto" onAction="#onFindInProject" />
                    </Menu>

                    <Menu fx:id="menuHerramientas" text="Herramientas">
